{
  "name": "dsh-session-delete",
  "version": "0.1.0",
  "description": "DSH Web 客户端：在侧边栏会话列表上长按（或右键）删除会话。",
  "keywords": ["dsh", "dsh-plugin", "session", "delete"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "license": "MIT"
}
