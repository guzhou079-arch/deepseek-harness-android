{
  "name": "dsh-user-profile",
  "version": "0.1.0",
  "private": true,
  "description": "用户资料面板：昵称、AI 对你的认知、说话语气。数据存 $DSH_HOME/user-profile.json，纯文本，删掉即回默认。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": [], "platform": "web" }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/page.js", "cordis.patch.yml"]
}
